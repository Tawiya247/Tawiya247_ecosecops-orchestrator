# ============================================================
# EcoSecOps Orchestrator — Variables d'Environnement
# IMPORTANT : Copier ce fichier en .env et remplir les valeurs
# Ne JAMAIS commiter .env dans Git
# ============================================================

# --- ElectricityMaps API ---
# Obtenir sur : https://api.electricitymap.org/
# Utilisé par connectors/electricity_client.py
ELECTRICITY_MAPS_API_KEY=your_electricitymaps_api_key_here

# --- OSV.dev API ---
# Endpoint public (pas de clé requise, mais configurable)
# Utilisé par connectors/osv_client.py
OSV_API_URL=https://api.osv.dev/v1/query

# --- Application ---
# Environnement d'exécution : development | production | test
APP_ENV=development

# --- Serveur FastAPI ---
# Port d'écoute pour uvicorn
PORT=8000

# --- Frontend ---
# URL du backend FastAPI (consommée par frontend/app.py)
BACKEND_URL=http://localhost:8000
